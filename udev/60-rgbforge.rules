# Sapphire Nitro+ RX 9070 XT: only the GPU's dedicated RGB I2C bus, no other I2C bus
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTR{name}=="AMDGPU DM i2c OEM bus*", TAG+="uaccess"
# G.Skill RAM lighting: the chipset SMBus. RGB Forge additionally refuses to use it unless
# the chipset's SPD Write Disable lock is on (hardware-blocks writes to memory-settings chips).
SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", ATTR{name}=="SMBus I801 adapter*", TAG+="uaccess"
# Each boot, as root, copy the SMBus HOSTC byte (holds the SPD Write Disable bit) to /run for RGB Forge to check.
ACTION=="add|change|bind", SUBSYSTEM=="pci", DRIVER=="i801_smbus", RUN+="/bin/sh -c 'mkdir -p /run/rgbforge && od -An -tx1 -j64 -N1 /sys%p/config > /run/rgbforge/smbus-hostc-%k'"
